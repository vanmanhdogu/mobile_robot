# Consumed by docker compose (build args + runtime env).
ROS_DISTRO=humble
WS_DIR=/home/dogu/ros2_humble_ws

# Match the host user so files in the mounted workspace stay yours.
USERNAME=dogu
UID=1000
GID=1000

# Host GIDs for GPU device access (video / render). Check with:
#   getent group video render
VIDEO_GID=44
RENDER_GID=993

# Host GID of the 'input' group, for /dev/input/js* (joystick). Check with:
#   getent group input
INPUT_GID=996

# ROS 2 DDS discovery. Same domain = same "network" of nodes (0-101).
ROS_DOMAIN_ID=0
# 1 restricts all traffic to this machine.
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Set to 1 if rviz2/gazebo crash or render black.
LIBGL_ALWAYS_SOFTWARE=0

# Gazebo Classic: auto (amd64 only) / yes / no. There is no arm64 build of
# ros-humble-gazebo-ros-pkgs for jammy, so on this Jetson it is skipped.
INSTALL_SIM=auto
