<?xml version="1.0"?>
<!--
  Gazebo-side definitions for the mobile base: surface friction, the
  ign_ros2_control system plugin, and the two 2D LiDAR sensors.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ── 2D LiDAR sensor macro ──
       A gpu_lidar publishes an ignition.msgs.LaserScan on <topic> and an
       ignition.msgs.PointCloudPacked on <topic>/points. Only the LaserScan is
       bridged (see launch/gazebo.launch.py).

       gpu_lidar requires the ogre2 render engine: under the older ogre engine
       every ray silently returns range_min. -->
  <xacro:macro name="Lidar2DSensor"
               params="link topic samples:=720 range_min:=0.60 range_max:=20.0
                       update_rate:=15 visualize:=false">
    <gazebo reference="${link}">
      <sensor name="${topic}" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <topic>${topic}</topic>
        <ignition_frame_id>${link}</ignition_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${range_min}</min>
            <max>${range_max}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.008</stddev>
          </noise>
        </lidar>
        <!-- Drawing 720 rays per frame is expensive; enable only to debug. -->
        <visualize>${visualize}</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ── Per-wheel friction macro ──
       Wheels grip, steering housings must not: any friction on the steering
       link fights the position-controlled steering joint. -->
  <xacro:macro name="WheelFriction" params="prefix">
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.8</mu1>
      <mu2>1.8</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
    <gazebo reference="${prefix}_steering_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="mobile_base_gazebo">
    <!-- base_link carries no collision geometry: the robot rests on the four
         wheel cylinders. These coefficients only matter if you add one. -->
    <gazebo reference="base_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
    </gazebo>

    <xacro:WheelFriction prefix="front_left"/>
    <xacro:WheelFriction prefix="front_right"/>
    <xacro:WheelFriction prefix="rear_left"/>
    <xacro:WheelFriction prefix="rear_right"/>

    <!-- ros2_control system plugin. The .so lives in the workspace overlay
         (install/gz_ros2_control/lib), not /opt/ros/humble/lib, so
         IGN_GAZEBO_SYSTEM_PLUGIN_PATH must include it or Gazebo comes up
         looking healthy with no controller loaded. -->
    <gazebo>
      <plugin filename="libign_ros2_control-system.so"
              name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(find mobile_base_sim)/config/swerve_controller.yaml</parameters>
      </plugin>
    </gazebo>

    <!-- Topic names match the AntBot simulation so existing tooling and the
         antbot_navigation stack can be pointed at this base unchanged. -->
    <xacro:Lidar2DSensor link="lidar_2d_front_link" topic="scan_0"/>
    <xacro:Lidar2DSensor link="lidar_2d_back_link"  topic="scan_1"/>
  </xacro:macro>

</robot>
