<?xml version="1.0" ?>
<!--
  Top-level URDF for the stripped-down AntBot mobile base.

  Keeps: the body, the four swerve wheel modules, and the two 2D LiDARs.
  Drops: every camera, the 3D LiDAR, the IMU, GNSS, the magnetometer and the
         charging coil.

  Geometry macros and meshes come from antbot_description, which is left
  completely untouched — this file only chooses which of its macros to
  instantiate. The dimension properties below MUST match the ones in
  antbot_description/urdf/antbot.xacro, because base.xacro and wheel.xacro
  read them out of the enclosing scope.
-->
<robot name="mobile_base" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Shared geometry macros from antbot_description -->
  <xacro:include filename="$(find antbot_description)/urdf/base.xacro"/>
  <xacro:include filename="$(find antbot_description)/urdf/wheel.xacro"/>
  <xacro:include filename="$(find antbot_description)/urdf/sensors.xacro"/>

  <!-- Simulation-specific definitions owned by this package -->
  <xacro:include filename="$(find mobile_base_sim)/urdf/ros2_control.xacro"/>
  <xacro:include filename="$(find mobile_base_sim)/urdf/gazebo_plugins.xacro"/>

  <!-- ── Dimensions (identical to the real AntBot base) ── -->
  <xacro:property name="wheelbase_length" value="0.530"/>
  <xacro:property name="wheelbase_width" value="0.512"/>
  <xacro:property name="steering_width" value="0.401"/>
  <xacro:property name="wheel_radius" value="0.103"/>
  <xacro:property name="steering_height" value="0.120"/>
  <xacro:property name="wheel_offset" value="${(wheelbase_width - steering_width)/2}"/>

  <!-- ── Body ── -->
  <xacro:Base/>

  <!-- ── Four swerve modules ──
       Steering joints sit at +-steering_width/2; each wheel is then offset
       outward by wheel_offset, putting the contact patch at
       +-wheelbase_width/2. That 55.5 mm non-coaxial offset is real and the
       controller compensates for it. -->
  <xacro:SwerveWheelLeft  position_name="front_left"
                          x_pos="${wheelbase_length/2}"  y_pos="${steering_width/2}"/>
  <xacro:SwerveWheelRight position_name="front_right"
                          x_pos="${wheelbase_length/2}"  y_pos="${-steering_width/2}"/>
  <xacro:SwerveWheelLeft  position_name="rear_left"
                          x_pos="${-wheelbase_length/2}" y_pos="${steering_width/2}"/>
  <xacro:SwerveWheelRight position_name="rear_right"
                          x_pos="${-wheelbase_length/2}" y_pos="${-steering_width/2}"/>

  <!-- ── 2D LiDAR mounting frames ──
       Same poses as the real robot. The front unit is mounted backwards,
       hence the 180 deg yaw. -->
  <xacro:Sensors name="lidar_2d_front" xyz="0.325 0.0 0.255" rpy="0.0 0.0 ${radians(180)}"/>
  <xacro:Sensors name="lidar_2d_back"  xyz="-0.325 0.0 0.255" rpy="0.0 0.0 0.0"/>

  <!-- ── Gazebo: friction, ros2_control plugin, LiDAR sensors ── -->
  <xacro:mobile_base_gazebo/>

  <!-- ── ros2_control hardware interface ── -->
  <xacro:mobile_base_ros2_control/>

</robot>
