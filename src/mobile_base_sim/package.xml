<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_base_sim</name>
  <version>0.1.0</version>
  <description>
    Minimal Ignition Gazebo simulation of the AntBot mobile base: body, four
    swerve wheel modules and the two 2D LiDARs. Nothing else — no cameras, no
    3D LiDAR, no IMU, no GNSS.

    Geometry is reused from antbot_description rather than copied, so this
    package stays small and follows upstream geometry fixes. No file in the
    antbot meta package is modified by installing or using this one.
  </description>
  <maintainer email="vanmanh.tran@dogu.xyz">Van Manh Tran</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Robot geometry: base.xacro, wheel.xacro, sensors.xacro + the STL meshes -->
  <exec_depend>antbot_description</exec_depend>
  <!-- The swerve controller plugin, loaded by name from config/ -->
  <exec_depend>antbot_swerve_controller</exec_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ign_ros2_control</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
