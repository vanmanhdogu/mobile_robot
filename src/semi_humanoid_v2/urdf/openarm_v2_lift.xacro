    <axis xyz="0 0 -1" />
    <limit effort="27" lower="${-1.5708 - openarm_sim_limit_margin}" upper="${1.5708 + openarm_sim_limit_margin}" velocity="5.4454" />
  </joint>
  
  <link name="openarm_left_link4">
    <visual name="openarm_left_link4_visual">
