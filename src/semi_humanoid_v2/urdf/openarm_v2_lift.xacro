<?xml version="1.0"?>
<!--
  OpenArm v2.0 bimanual (pinch grippers) on a lift column, for semi_humanoid_v2.
  Generated from openarm_description/assets/robot/openarm_v2.0/urdf/example/v2.urdf
  (via antbot_openarm_description). Changes vs. upstream:
    * no world link; the column is fixed to ${parent} by openarm_body_mount_joint
    * openarm_body_link0 is only the base plate + a 60x60 rail up to z=0.75
    * the chest, both shoulders and the split shoulder bar ride on
      openarm_lift_link, driven by the prismatic openarm_lift_joint (z axis).
      q = 0 is the home height (shoulders 0.50 m above the column foot,
      0.832 m above ground); q = -0.34 is the bottom stop (shoulders 0.16 m
      above the foot), where the grippers reach the ground. Upward travel is
      stopped by openarm_top_crossbar, fixed to the rail just above the chest.
    * shoulders spread to y=+-0.186 (upstream +-0.031)
    * upstream ros2_control blocks dropped (see ros2_control_gazebo.xacro)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- In Gazebo every joint stop sits this far outside the real limit.
       gz_ros2_control applies position commands as DART velocity commands,
       and DART stops responding to a velocity command once the joint touches
       its position limit (gazebosim/gz-sim#1684). The arms spawn at all-zero,
       which is exactly on the lower limit of joint4 and the left fingers, so
       without a margin those joints can stay stuck. Commands inside the real
       range never reach the widened stops. -->
  <xacro:property name="openarm_sim_limit_margin" value="${0.02 if '$(arg sim_gazebo)'.lower() == 'true' else 0.0}"/>
  <xacro:macro name="OpenArmLift" params="parent xyz:='0.1 0.0 0.315' rpy:='0 0 0'">
  <joint name="openarm_body_mount_joint" type="fixed">
    <origin xyz="${xyz}" rpy="${rpy}"/>
    <parent link="${parent}"/>
    <child link="openarm_body_link0"/>
  </joint>
  <link name="openarm_body_link0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://semi_humanoid_v2/meshes/openarm_body_column.stl"/>
      </geometry>
      <material name="openarm_body_grey">
        <color rgba="0.35 0.35 0.37 1"/>
      </material>
    </visual>
    <!-- base plate / 60x60 rail -->
    <collision>
      <origin xyz="-0.030 0 0.032" rpy="0 0 0"/>
      <geometry><box size="0.250 0.190 0.064"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.407" rpy="0 0 0"/>
      <geometry><box size="0.060 0.060 0.686"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.02 0 0.15" rpy="0 0 0"/>
      <mass value="9.0"/>
      <inertia ixx="0.4500" ixy="0" ixz="0" iyy="0.4700" iyz="0" izz="0.0740"/>
    </inertial>
  </link>
  <!-- Top bar, fixed to the rail just above the chest: 40x40, 3 cm wider than the shoulders. -->
  <joint name="openarm_top_crossbar_joint" type="fixed">
    <origin xyz="0 0 0.600" rpy="0 0 0"/>
    <parent link="openarm_body_link0"/>
    <child link="openarm_top_crossbar_link"/>
  </joint>
  <link name="openarm_top_crossbar_link">
    <visual>
      <geometry><box size="0.04 0.746 0.04"/></geometry>
      <material name="aluminium"><color rgba="0.55 0.56 0.58 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.04 0.746 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <inertia ixx="0.05582" ixy="0" ixz="0" iyy="0.00032" iyz="0" izz="0.05582"/>
    </inertial>
  </link>

  <!-- Lift: the carriage frame sits at the shoulder centre line. -->
  <xacro:property name="openarm_lift_lower" value="-0.340"/>
  <xacro:property name="openarm_lift_upper" value="0.0"/>
  <xacro:property name="openarm_lift_sim_margin" value="${0.005 if '$(arg sim_gazebo)'.lower() == 'true' else 0.0}"/>
  <joint name="openarm_lift_joint" type="prismatic">
    <origin xyz="0 0 0.500" rpy="0 0 0"/>
    <parent link="openarm_body_link0"/>
    <child link="openarm_lift_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2000" velocity="0.10"
           lower="${openarm_lift_lower - openarm_lift_sim_margin}"
           upper="${openarm_lift_upper + openarm_lift_sim_margin}"/>
    <dynamics damping="50.0" friction="0.0"/>
  </joint>
  <link name="openarm_lift_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://semi_humanoid_v2/meshes/openarm_lift_chest.stl"/>
      </geometry>
      <material name="openarm_body_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.010 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="0.150 0.160 0.160"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.01 0 0" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.01707" ixy="0" ixz="0" iyy="0.01603" iyz="0" izz="0.01603"/>
    </inertial>
  </link>

  <!-- Shoulder bar, split around the rail: chest side (|y| = 0.07) to shoulder (|y| = 0.196). -->
  <joint name="openarm_shoulder_crossbar_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="openarm_lift_link"/>
    <child link="openarm_shoulder_crossbar_link"/>
  </joint>
  <link name="openarm_shoulder_crossbar_link">
    <visual>
      <origin xyz="0 0.133 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.126 0.04"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0 -0.133 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.126 0.04"/></geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0.133 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.126 0.04"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.133 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.126 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.00712" ixy="0" ixz="0" iyy="0.00011" iyz="0" izz="0.00712"/>
    </inertial>
  </link>
  <link name="openarm_left_base_link">
    <visual name="openarm_left_base_link_visual">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://semi_humanoid_v2/meshes/openarm/arm/visual/base_link.dae" scale="1 -1 1" />
      </geometry>
      <material name="openarm_left_base_link_material">
        <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
      </material>
    </visual>
    <collision name="openarm_left_base_link_collision">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://semi_humanoid_v2/meshes/openarm/arm/collision/mirrored/base_link.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.00253123748061566 0.0258185540330169 2.70658291858903e-05" />
      <mass value="1.1432284943239561" />
      <inertia ixx="0.00113607806226198" ixy="-3.81487993180929e-07" ixz="1.09161247709715e-08" iyy="0.00159935208714031" iyz="-2.7521421737084e-08" izz="0.000750541980863571" />
    </inertial>
  </link>
  
  <joint name="openarm_left_base_link_mount_joint" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.186 0.0" />
    <parent link="openarm_lift_link" />
    <child link="openarm_left_base_link" />
  </joint>
  
  <link name="openarm_left_link1">
    <visual name="openarm_left_link1_visual">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://semi_humanoid_v2/meshes/openarm/arm/visual/link1.dae" scale="1 -1 1" />
      </geometry>
      <material name="openarm_left_link1_material">
