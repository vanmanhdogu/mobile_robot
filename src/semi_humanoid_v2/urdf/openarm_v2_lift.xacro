    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.000900350355624244 0.0444659716892874 2.88441021165683e-05" />
      <mass value="1.1416684646202298" />
      <inertia ixx="0.0010943212038551" ixy="-9.41628673674543e-06" ixz="4.53422182483102e-08" iyy="0.000759199728161993" iyz="-6.66755698859637e-08" izz="0.000670659201019629" />
    </inertial>
  </link>
  
  <joint name="openarm_left_joint1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0.0625 0" />
    <parent link="openarm_left_base_link" />
    <child link="openarm_left_link1" />
    <axis xyz="0 1 0" />
    <limit effort="40" lower="${-3.4907 - openarm_sim_limit_margin}" upper="${1.3963 + openarm_sim_limit_margin}" velocity="16.755" />
  </joint>
  
  <link name="openarm_left_link2">
    <visual name="openarm_left_link2_visual">
      <origin rpy="0 0 0" xyz="0 0 0" />
