  <joint name="openarm_left_finger_joint1" type="revolute">
    <origin rpy="0.0 -0.0 0.0" xyz="-0.0014300000000005003 -0.0180000000000009 -0.0680000000000174" />
    <parent link="openarm_left_ee_base_link" />
