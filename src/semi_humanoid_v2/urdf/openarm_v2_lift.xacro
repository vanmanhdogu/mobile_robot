      <origin rpy="0 0 0" xyz="-0.00300861804638783 -0.000514813312550808 -0.109368241429434" />
      <mass value="1.073863338202347" />
      <inertia ixx="0.00128939636591746" ixy="-2.29951046666492e-07" ixz="-6.76161926984358e-05" iyy="0.00114018992179734" iyz="-1.06260802872572e-05" izz="0.000559765478676303" />
    </inertial>
  </link>
  
  <joint name="openarm_left_joint3" type="revolute">
