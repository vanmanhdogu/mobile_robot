<?xml version="1.0" ?>
<!--
  semi_humanoid_v2_real.urdf.xacro + two RoboSense Airy hemispherical 3D LiDARs.

  The real model is included unchanged; this file only adds the airy links,
  their fixed joints and (with sim_gazebo) a gpu_lidar per unit. The unit
  itself is urdf/airy_lidar.xacro's AiryLidar macro, shared with
  semi_humanoid_v3.urdf.xacro; see that file for the datasheet mapping and the
  frame convention.

  Default mounts: back to back on the body column, facing opposite ways, so the
  two hemispheres together cover the whole sphere around the robot:

    airy_link       front (x = +0.200, z = 0.92), pitch +90 deg -> dome faces +x
    airy_back_link  rear  (x = -0.354, z = 0.77), pitch -90 deg -> dome faces -x

  Move either one with its own _xyz / _rpy args.

  Args (in addition to those of semi_humanoid_v2_real.urdf.xacro):
    airy                        add the front sensor (true)
    airy_xyz, airy_rpy          front mount pose relative to base_link
    airy_back                   add the rear sensor (true)
    airy_back_xyz, airy_back_rpy  rear mount pose relative to base_link
    airy_vertical_samples       192 / 96 / 48 (96), used by both units

  Topics (sim_gazebo): gz "airy" and "airy_back"; the launch file bridges them
  to /airy_points and /airy_back_points.
-->
<robot name="semi_humanoid_v2" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="airy" default="true"/>
  <xacro:arg name="airy_xyz" default="0.200 0.0 0.92"/>
  <xacro:arg name="airy_rpy" default="0.0 1.5707963 0.0"/>
  <xacro:arg name="airy_back" default="true"/>
  <xacro:arg name="airy_back_xyz" default="-0.354 0.0 0.77"/>
  <xacro:arg name="airy_back_rpy" default="0.0 -1.5707963 0.0"/>
  <xacro:arg name="airy_vertical_samples" default="96"/>

  <xacro:include filename="$(find semi_humanoid_v2)/urdf/semi_humanoid_v2_real.urdf.xacro"/>
  <!-- Must follow the real model: AiryLidar uses Lidar3DSensor, which
       gazebo_plugins.xacro defines inside that model's sim_gazebo branch. -->
  <xacro:include filename="$(find semi_humanoid_v2)/urdf/airy_lidar.xacro"/>

  <xacro:if value="$(arg airy)">
    <xacro:AiryLidar name="airy" xyz="$(arg airy_xyz)" rpy="$(arg airy_rpy)"
      vertical_samples="$(arg airy_vertical_samples)"/>
  </xacro:if>

  <xacro:if value="$(arg airy_back)">
    <xacro:AiryLidar name="airy_back" xyz="$(arg airy_back_xyz)" rpy="$(arg airy_back_rpy)"
      vertical_samples="$(arg airy_vertical_samples)"/>
  </xacro:if>
</robot>
